            </div>

            <div class="field">
                <label for="businessPhone">Phone Number</label>
                <input id="businessPhone" placeholder="+1 234 567 890">
            </div>
        </div>

        <h2 class="section-title">Invoice Details</h2>

        <div class="grid">
            <div class="field">
                <label for="invoiceNumber">Invoice Number</label>
                <input id="invoiceNumber" value="INV-001">
            </div>

            <div class="field">
                <label for="currency">Currency</label>
                <select id="currency">

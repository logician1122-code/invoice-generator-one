<script>
    const itemsBody = document.getElementById("itemsBody");

    const currencySymbols = {
        USD: "$",
        PKR: "Rs ",
        GBP: "£",
        EUR: "€",
        CAD: "CA$",
        AUD: "A$",
        AED: "AED ",
        INR: "₹"
    };

    function money(amount) {
        const currency = document.getElementById("currency").value;
        const symbol = currencySymbols[currency] || currency + " ";

        return symbol + Number(amount).toLocaleString("en-US", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function addItem() {
        const row = document.createElement("tr");

        row.innerHTML = `
            <td>
                <input class="item-name" aria-label="Item description"
                       placeholder="Service or product">
            </td>
            <td>
                <input class="quantity" aria-label="Quantity"
                       type="number" min="0" step="any" value="1">
            </td>
            <td>
                <input class="price" aria-label="Unit price"
                       type="number" min="0" step="any" value="0">
            </td>
            <td class="amount">0.00</td>
            <td class="no-print">
                <button type="button" class="remove-btn"
                        onclick="removeItem(this)">X</button>
            </td>
        `;

        itemsBody.appendChild(row);
        calculateTotals();
    }

    function removeItem(button) {
        button.closest("tr").remove();
        calculateTotals();
    }

    function calculateTotals() {
        let subtotal = 0;

        const rows = itemsBody.querySelectorAll("tr");

        rows.forEach(row => {
            const quantity = Math.max(
                0,
                Number(row.querySelector(".quantity").value) || 0
            );

            const price = Math.max(
                0,
                Number(row.querySelector(".price").value) || 0
            );

            const amount = quantity * price;

            subtotal += amount;
            row.querySelector(".amount").textContent = money(amount);
        });

        const taxInput = document.getElementById("taxRate");
        const taxRate = Math.min(
            100,
            Math.max(0, Number(taxInput.value) || 0)
        );

        const tax = subtotal * taxRate / 100;
        const total = subtotal + tax;

        document.getElementById("subtotal").textContent = money(subtotal);
        document.getElementById("taxAmount").textContent = money(tax);
        document.getElementById("grandTotal").textContent = money(total);
    }

    function printInvoice() {
        const businessName = document.getElementById("businessName").value.trim();
        const clientName = document.getElementById("clientName").value.trim();

        if (!businessName) {
            alert("Please enter your business name before printing.");
            document.getElementById("businessName").focus();
            return;
        }

        if (!clientName) {
            alert("Please enter the client's name before printing.");
            document.getElementById("clientName").focus();
            return;
        }

        window.print();
    }

    function resetInvoice() {
        const confirmed = confirm(
            "Are you sure you want to clear this invoice?"
        );

        if (!confirmed) return;

        document.querySelectorAll(
            "#businessName, #businessEmail, #businessAddress, " +
            "#businessPhone, #clientName, #clientEmail, " +
            "#clientAddress, #notes"
        ).forEach(input => {
            input.value = "";
        });

        document.getElementById("invoiceNumber").value = "INV-001";
        document.getElementById("taxRate").value = "0";

        itemsBody.innerHTML = `
            <tr>
                <td>
                    <input class="item-name" aria-label="Item description"
                           placeholder="Service or product">
                </td>
                <td>
                    <input class="quantity" aria-label="Quantity"
                           type="number" min="0" step="any" value="1">
                </td>
                <td>
                    <input class="price" aria-label="Unit price"
                           type="number" min="0" step="any" value="0">
                </td>
                <td class="amount">0.00</td>
                <td class="no-print">
                    <button type="button" class="remove-btn"
                            onclick="removeItem(this)">X</button>
                </td>
            </tr>
        `;

        setDefaultDates();
        calculateTotals();
    }

    function setDefaultDates() {
        const today = new Date();
        const localDate = new Date(
            today.getTime() - today.getTimezoneOffset() * 60000
        ).toISOString().slice(0, 10);

        document.getElementById("invoiceDate").value = localDate;

        const due = new Date(today);
        due.setDate(due.getDate() + 7);

        const localDueDate = new Date(
            due.getTime() - due.getTimezoneOffset() * 60000
        ).toISOString().slice(0, 10);

        document.getElementById("dueDate").value = localDueDate;
    }

